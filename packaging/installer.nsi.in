!include "MUI2.nsh"

!define APPNAME "GeoGebra Discovery"
!define APPVER "@PKGVER@"
!define COMPANY "GeoGebra"
!define OUTFILE "@OUTPUT_FILE@"
!define BUILD_DIR "@BUILD_DIR@"
!define ICON_FILE "${BUILD_DIR}/geogebra-discovery.ico"

Name "${APPNAME}"
OutFile "${OUTFILE}"
InstallDir "$PROGRAMFILES64\GeoGebra Discovery"
InstallDirRegKey HKLM "Software\${APPNAME}" "InstallDir"
RequestExecutionLevel admin

!define MUI_ICON "${ICON_FILE}"
!define MUI_UNICON "${ICON_FILE}"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES

!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_FUNCTION "LaunchApp"
!define MUI_FINISHPAGE_RUN_TEXT "Start GeoGebra Discovery now"
!define MUI_FINISHPAGE_RUN_CHECKED

!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Function .onInit
  SetRegView 64
  SetShellVarContext all
FunctionEnd

Function un.onInit
  SetRegView 64
  SetShellVarContext all
FunctionEnd

Function LaunchApp
  SetOutPath "$INSTDIR"
  Exec '"$INSTDIR\bin\GeoGebra-Discovery.bat"'
FunctionEnd

Section "MainSection" SEC_APP
  SectionIn RO ; Marks this section as Read-Only so users cannot uncheck it

  SetOutPath "$INSTDIR"
  File /r "${BUILD_DIR}/*"

  WriteUninstaller "$INSTDIR\uninstall.exe"

  CreateDirectory "$SMPROGRAMS\${APPNAME}"

  ; Windows doesn's thread .bat the same as .exes
  ; The "$SYSDIR\cmd.exe" is needed as a workaround to link points to an .exe instead of a .bat file

  ; 1. Standard Shortcuts
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" \
    "$SYSDIR\cmd.exe" \
    '/c "$\"$INSTDIR\bin\GeoGebra-Discovery.bat$\""' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWMINIMIZED "" "${APPNAME}"

  CreateShortcut "$DESKTOP\${APPNAME}.lnk" \
    "$SYSDIR\cmd.exe" \
    '/c "$\"$INSTDIR\bin\GeoGebra-Discovery.bat$\""' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWMINIMIZED "" "${APPNAME}"

  ; 2. Debug Shortcut
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME} (Debug Mode).lnk" \
    "$SYSDIR\cmd.exe" \
    '/k "$\"$INSTDIR\bin\GeoGebra-Discovery-Debug.bat$\""' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWNORMAL "" "${APPNAME} with Console Output"

  ; 3. Uninstaller Shortcut
  CreateShortcut "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk" \
    "$INSTDIR\uninstall.exe" "" "$INSTDIR\uninstall.exe" 0

  ; Windows Add/Remove Programs Registration
  !define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPNAME}"

  WriteRegStr HKLM "${UNINST_KEY}" "DisplayName" "${APPNAME}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion" "${APPVER}"
  WriteRegStr HKLM "${UNINST_KEY}" "Publisher" "${COMPANY}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\geogebra-discovery.ico"
  WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINST_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKLM "${UNINST_KEY}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair" 1
  WriteRegDWORD HKLM "${UNINST_KEY}" "WindowsInstaller" 0
  WriteRegDWORD HKLM "${UNINST_KEY}" "EstimatedSize" 166000
SectionEnd

Section "Add to PATH environment variable" SEC_PATH
  EnVar::SetHKLM
  EnVar::AddValue "Path" "$INSTDIR\bin"
  Pop $0

  ; Record that PATH was modified so the uninstaller knows to remove it
  WriteRegDWORD HKLM "Software\${APPNAME}" "AddedToPath" 1
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_APP} "Installs the core GeoGebra Discovery binaries and desktop shortcuts."
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_PATH} "Adds GeoGebra Discovery's bin directory to the system PATH so you can invoke it from any Command Prompt or PowerShell."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
  ReadRegDWORD $0 HKLM "Software\${APPNAME}" "AddedToPath"
  ${If} $0 == 1
    EnVar::SetHKLM
    EnVar::DeleteValue "Path" "$INSTDIR\bin"
    Pop $1
  ${EndIf}

  Delete "$DESKTOP\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME} (Debug Mode).lnk"
  Delete "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk"
  RMDir "$SMPROGRAMS\${APPNAME}"

  RMDir /r "$INSTDIR\bin"
  RMDir /r "$INSTDIR\lib"
  RMDir /r "$INSTDIR\jre"
  Delete "$INSTDIR\geogebra-discovery.ico"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"

  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPNAME}"
  DeleteRegKey HKLM "Software\${APPNAME}"
SectionEnd