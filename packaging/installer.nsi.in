Unicode true ;

!include "MUI2.nsh"

!define APPNAME "GeoGebra Discovery"
!define APPVER "@PKGVER@"
!define COMPANY "GeoGebra"
!define OUTFILE "@OUTPUT_FILE@"
!define BUILD_DIR "@BUILD_DIR@"
!define ICON_FILE "${BUILD_DIR}/geogebra-discovery.ico"

Name "${APPNAME}"
OutFile "${OUTFILE}"
InstallDir "$PROGRAMFILES64\GeoGebra Discovery"
InstallDirRegKey HKLM "Software\${APPNAME}" "InstallDir"
RequestExecutionLevel admin

!define MUI_ICON "${ICON_FILE}"
!define MUI_UNICON "${ICON_FILE}"
!define MUI_WELCOMEFINISHPAGE_BITMAP "${BUILD_DIR}\app_preview.bmp"

!insertmacro MUI_PAGE_WELCOME
!define MUI_PAGE_CUSTOMFUNCTION_SHOW ComponentsShow
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES

!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_FUNCTION "LaunchApp"
!define MUI_FINISHPAGE_RUN_TEXT "$(TEXT_StartApp)"
!define MUI_FINISHPAGE_RUN_CHECKED

!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "Hebrew"
!insertmacro MUI_LANGUAGE "Arabic"
!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "Hungarian"

; Desktop shortcut
LangString DESC_DesktopShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString DESC_DesktopShortcut ${LANG_GERMAN} "Desktop-Verknüpfung erstellen"
LangString DESC_DesktopShortcut ${LANG_SPANISH} "Crear acceso directo en el escritorio"
LangString DESC_DesktopShortcut ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString DESC_DesktopShortcut ${LANG_HEBREW} "צור קיצור דרך בשולחן העבודה"
LangString DESC_DesktopShortcut ${LANG_ARABIC} "إنشاء اختصار على سطح المكتب"
LangString DESC_DesktopShortcut ${LANG_ITALIAN} "Crea un collegamento sul desktop"
LangString DESC_DesktopShortcut ${LANG_HUNGARIAN} "Asztali parancsikon létrehozása"

; PATH env var
LangString DESC_PathOption ${LANG_ENGLISH} "Add to PATH environment variable"
LangString DESC_PathOption ${LANG_GERMAN} "Zur PATH-Umgebungsvariable hinzufügen"
LangString DESC_PathOption ${LANG_SPANISH} "Añadir a la variable de entorno PATH"
LangString DESC_PathOption ${LANG_SIMPCHINESE} "添加到 PATH 环境变量"
LangString DESC_PathOption ${LANG_HEBREW} "הוסף למשתנה הסביבה PATH"
LangString DESC_PathOption ${LANG_ARABIC} "إضافة إلى متغير البيئة PATH"
LangString DESC_PathOption ${LANG_ITALIAN} "Aggiungi alla variabile di ambiente PATH"
LangString DESC_PathOption ${LANG_HUNGARIAN} "Hozzáadás a PATH környezeti változóhoz"

; Start GeoGebra Discovery
LangString TEXT_StartApp ${LANG_ENGLISH} "Start GeoGebra Discovery now"
LangString TEXT_StartApp ${LANG_GERMAN} "GeoGebra Discovery jetzt starten"
LangString TEXT_StartApp ${LANG_SPANISH} "Iniciar GeoGebra Discovery ahora"
LangString TEXT_StartApp ${LANG_SIMPCHINESE} "立即启动 GeoGebra Discovery"
LangString TEXT_StartApp ${LANG_HEBREW} "הפעל את GeoGebra Discovery כעת"
LangString TEXT_StartApp ${LANG_ARABIC} "تشغيل GeoGebra Discovery الآن"
LangString TEXT_StartApp ${LANG_ITALIAN} "Avvia GeoGebra Discovery adesso"
LangString TEXT_StartApp ${LANG_HUNGARIAN} "A GeoGebra Discovery indítása most"

Function ComponentsShow
  ; Find the inner page dialog (child of $HWNDPARENT)
  FindWindow $1 "#32770" "" $HWNDPARENT

  ; 1. Hide the Description groupbox (1042) and text (1043)
  GetDlgItem $0 $1 1042
  ShowWindow $0 0
  GetDlgItem $0 $1 1043
  ShowWindow $0 0

  ; 2. Expand the components treeview (1032) across the dialog
  ; Width ~340 pixels spans across to the right margin
  GetDlgItem $0 $1 1032
  ; SetWindowPos(hWnd, hWndInsertAfter, X, Y, cx, cy, uFlags)
  ; 0x6 = SWP_NOMOVE (0x2) | SWP_NOZORDER (0x4)
  System::Call "user32::SetWindowPos(p $0, p 0, i 0, i 0, i 340, i 140, i 0x6)"
FunctionEnd

Function .onInit
  SetRegView 64
  SetShellVarContext all

  !insertmacro MUI_LANGDLL_DISPLAY
FunctionEnd

Function un.onInit
  SetRegView 64
  SetShellVarContext all

  ReadRegStr $0 HKLM "Software\${APPNAME}" "InstallerLanguage"
  ${If} $0 != ""
    StrCpy $LANGUAGE $0
  ${EndIf}
FunctionEnd

Function LaunchApp
  SetOutPath "$INSTDIR"
  Exec '"$INSTDIR\jre\bin\javaw.exe" -cp "$INSTDIR\lib\*" -Dnashorn.args=--no-deprecation-warning org.geogebra.desktop.GeoGebra3D'
FunctionEnd

Section "GeoGebra Discovery" SEC_APP
  SectionIn RO

  SetOutPath "$INSTDIR"
  File /r "${BUILD_DIR}/*"

  WriteUninstaller "$INSTDIR\uninstall.exe"

  ; Saving the selected language for the uninstaller
  WriteRegStr HKLM "Software\${APPNAME}" "InstallerLanguage" "$LANGUAGE"

  CreateDirectory "$SMPROGRAMS\${APPNAME}"

  ; Standard Shortcuts
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" \
    "$INSTDIR\jre\bin\javaw.exe" \
    '-cp "$INSTDIR\lib\*" -Dnashorn.args=--no-deprecation-warning org.geogebra.desktop.GeoGebra3D' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWNORMAL "" "${APPNAME}"

  ; Debug Shortcut
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME} (Debug Mode).lnk" \
    "$SYSDIR\cmd.exe" \
    '/c "$\"$INSTDIR\bin\GeoGebra-Discovery.bat$\""' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWNORMAL "" "${APPNAME} with Console Output"

  ; Uninstaller Shortcut
  CreateShortcut "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk" \
    "$INSTDIR\uninstall.exe" "" "$INSTDIR\uninstall.exe" 0

  ; Windows Add/Remove Programs Registration
  !define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPNAME}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayName" "${APPNAME}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion" "${APPVER}"
  WriteRegStr HKLM "${UNINST_KEY}" "Publisher" "${COMPANY}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\geogebra-discovery.ico"
  WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINST_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKLM "${UNINST_KEY}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair" 1
  WriteRegDWORD HKLM "${UNINST_KEY}" "WindowsInstaller" 0
  WriteRegDWORD HKLM "${UNINST_KEY}" "EstimatedSize" 166000
SectionEnd

Section "$(DESC_DesktopShortcut)" SEC_DESKTOP_SHORTCUT
  CreateShortcut "$DESKTOP\${APPNAME}.lnk" \
    "$INSTDIR\jre\bin\javaw.exe" \
    '-cp "$INSTDIR\lib\*" -Dnashorn.args=--no-deprecation-warning org.geogebra.desktop.GeoGebra3D' \
    "$INSTDIR\geogebra-discovery.ico" 0 \
    SW_SHOWNORMAL "" "${APPNAME}"
SectionEnd

Section "$(DESC_PathOption)" SEC_PATH
  EnVar::SetHKLM
  EnVar::AddValue "Path" "$INSTDIR\bin"
  Pop $0

  ; Record that PATH was modified so the uninstaller knows to remove it
  WriteRegDWORD HKLM "Software\${APPNAME}" "AddedToPath" 1
SectionEnd

Section "Uninstall"
  ReadRegDWORD $0 HKLM "Software\${APPNAME}" "AddedToPath"
  ${If} $0 == 1
    EnVar::SetHKLM
    EnVar::DeleteValue "Path" "$INSTDIR\bin"
    Pop $1
  ${EndIf}

  Delete "$DESKTOP\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME} (Debug Mode).lnk"
  Delete "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk"
  RMDir "$SMPROGRAMS\${APPNAME}"

  RMDir /r "$INSTDIR\bin"
  RMDir /r "$INSTDIR\lib"
  RMDir /r "$INSTDIR\jre"
  Delete "$INSTDIR\geogebra-discovery.ico"
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"

  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPNAME}"
  DeleteRegKey HKLM "Software\${APPNAME}"
SectionEnd